{
  "expo": {
    "name": "RMUTP Campus",
    "slug": "rmutp-campus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#420671"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "th.ac.rmutp.campus",
      "buildNumber": "1.0.0",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "อนุญาตใช้กล้องสำหรับสแกน QR เช็คชื่อ",
        "NSFaceIDUsageDescription": "ใช้ FaceID ยืนยันตัวตนก่อนเข้าระบบ"
      }
    },
    "android": {
      "package": "th.ac.rmutp.campus",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#420671"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "อนุญาตใช้กล้องสำหรับสแกน QR เช็คชื่อ"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "rmutp-campus"
      }
    }
  }
}
