# =============================================================================
# .env.example (ไฟล์แม่แบบการตั้งค่าฐานข้อมูล 2 ระบบสำหรับทีมพัฒนา)
# วิธีใช้งาน:
#   1. คัดลอกไฟล์นี้และเปลี่ยนชื่อเป็น .env (cp .env.example .env)
#   2. นำค่า SUPABASE_URL และ SUPABASE_ANON_KEY จากโปรเจกต์ Supabase ใหม่มาใส่
#   3. รันแอปด้วยคำสั่ง: flutter run --dart-define-from-file=.env
# =============================================================================

# โหมดเริ่มต้นของฐานข้อมูล: 'supabase' หรือ 'university_sql'
DB_BACKEND_MODE=supabase

# -----------------------------------------------------------------------------
# ระบบที่ 1: Supabase Cloud API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-new-project-ref.supabase.co
SUPABASE_ANON_KEY=your-new-supabase-anon-public-key

# -----------------------------------------------------------------------------
# ระบบที่ 2: University SQL Server (ผ่าน Node.js/Express REST API Middleware)
# -----------------------------------------------------------------------------
UNIVERSITY_API_URL=http://localhost:4000/api
