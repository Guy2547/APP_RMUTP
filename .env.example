# =============================================================================
# .env.example (ไฟล์ตัวอย่างการตั้งค่าฐานข้อมูลสำหรับทีมพัฒนา)
# วิธีใช้งาน:
#   1. คัดลอกไฟล์นี้และเปลี่ยนชื่อเป็น .env (cp .env.example .env)
#   2. นำค่า SUPABASE_URL และ SUPABASE_ANON_KEY จากทีม Database มาใส่
#   3. รันแอปด้วยคำสั่ง: flutter run --dart-define-from-file=.env
# =============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_REST_URL=https://your-project-ref.supabase.co/rest/v1
SUPABASE_ANON_KEY=your-supabase-anon-public-key
